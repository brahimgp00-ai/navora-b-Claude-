# Server
PORT=4000
# Comma-separated list of allowed origins for CORS (frontend URLs).
# Use * to allow any origin (development only).
CORS_ORIGIN=http://localhost:5173

# Token required in the `x-admin-token` header to read orders via the admin endpoints.
ADMIN_TOKEN=change-me-in-production

# Where order records are persisted (JSON file, relative to project root).
ORDERS_FILE=data/orders.json
